# Example environment variables for RoleLens
# Rename to .env and populate with your real credentials for local development

# Adzuna API credentials (required to run ETL against Adzuna)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# MongoDB connection URL used by pymongo
# Example for a local docker-compose MongoDB service:
# mongodb://<user>:<password>@mongo:27017/rolelens_dev_db
DATABASE_URL=mongodb://job_user:job_password@mongo:27017/rolelens_dev_db

# Optional: override test DB (not required when tests use mongomock)
# TEST_DATABASE_URL=mongodb://job_user:job_password@mongo:27017/rolelens_test_db
